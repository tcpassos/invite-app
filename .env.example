# Copie para .env e preencha antes de subir o ambiente.
# O .env não vai para o repositório. O motivo de segredo não entrar em camada de
# imagem está na seção 10.4 do Guia da Arquitetura.

# ---------------------------------------------------------------- Banco
POSTGRES_USER=invite_app
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=invite_app

# ---------------------------------------------------------------- API
# Segredo que assina o cookie de sessão do anfitrião (ADR-0010).
# Gere um valor aleatório e não reaproveite de outro projeto:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-este-segredo

# ---------------------------------------------------------------- Front
# Endereço da API como o NAVEGADOR a alcança. É a porta publicada no host, e
# nunca o nome de serviço do compose, porque o navegador não resolve aquele nome.
# Trocar este valor exige reconstruir a imagem do front, porque o Next.js congela
# NEXT_PUBLIC_* na compilação.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------- Comuns
NODE_ENV=development
IMAGE_TAG=dev

@startuml classes-participantes-uc005
' Classes participantes do UC005, Confirmar presença, com a extensão do UC006, em notação BCE.
' Gera o PNG sem instalar nada além do Docker, a partir da pasta onde este arquivo está:
'   docker run --rm -v "<caminho>:/data" plantuml/plantuml -tpng /data/classes-participantes-uc005.puml
' No Windows, <caminho> é o caminho absoluto da pasta, por exemplo D:\invite-app\docs\.attachments
' É o Diagrama de Classes recortado para este caso de uso, e não o do sistema inteiro.
' Cada operação corresponde a uma mensagem de diagrama-sequencia-bce-uc005.
' Identificadores em inglês, conforme o Guia de Estilo.

skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam nodesep 25

class PublicInviteScreen <<boundary>> {
  + openInvite(publicToken : String) : void
  + showInviteForm(invite : Invite, categories : DietaryCategory [0..*]) : void
  + submitRsvp(rsvpCommand : RsvpCommand) : void
  + buildPersonalLink(personalToken : String) : String
  + showConfirmation(link : String) : void
  + showCapacityExceeded() : void
  + showValidationError(field : String, rule : String) : void
}

class RsvpController <<control>> {
  + getPublishedInvite(publicToken : String) : Invite [0..1]
  + registerRsvp(publicToken : String, rsvpCommand : RsvpCommand) : Guest
  - checkCompanionLimit(invite : Invite, companionCount : Integer) : Boolean
  - validateDietaryNote(freeText : String [0..1], categories : DietaryCategory [0..*]) : Boolean
  - generatePersonalToken() : String
}

class Invite <<entity>> {
  + eventName : String [1]
  + eventStartsAt : DateTime [1]
  + location : String [1]
  + status : InviteStatus [1]
  + publicToken : String [0..1] {unique}
  + capacityLimit : Integer [0..1]
  + maxCompanionsPerGuest : Integer [0..1]
  --
  + findPublishedByPublicToken(publicToken : String) : Invite [0..1]
  + reserveSeats(seatsRequested : Integer) : Boolean
}

class Guest <<entity>> {
  + name : String [1]
  + status : RsvpStatus [1]
  + companionCount : Integer [1] = 0
  + personalToken : String [1] {unique}
  + respondedAt : DateTime [1]
}

class DietaryNote <<entity>> {
  + freeText : String [0..1]
}

class DietaryCategory <<entity>> {
  + code : String [1] {unique}
  + displayName : String [1]
  + requiresDescription : Boolean [1]
  --
  + listDietaryCategories() : DietaryCategory [0..*]
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

PublicInviteScreen ..> RsvpController
RsvpController ..> Invite
RsvpController ..> DietaryCategory

Invite "1" *-- "0..*" Guest
Guest "1" *-- "0..1" DietaryNote
DietaryNote "0..*" -- "0..*" DietaryCategory
Guest ..> RsvpStatus

@enduml

@startuml diagrama-de-classes
' Fonte do Diagrama de Classes de Domínio da Sprint 2, item #61 do Azure Boards.
' Gera o PNG sem instalar nada além do Docker, a partir da pasta onde este arquivo está:
'   docker run --rm -v "<caminho>:/data" plantuml/plantuml -tpng /data/diagrama-de-classes.puml
' No Windows, <caminho> é o caminho absoluto da pasta, por exemplo D:\invite-app\docs\.attachments
' Identificadores em inglês, conforme o Guia de Estilo.
' A descrição de cada classe fica na página da wiki, não dentro do diagrama.
' As três consultas do painel não são operações de Invite. Elas são serviços do Domínio,
' conforme a seção 11.3 do Guia da Arquitetura.

skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 70
hide empty members

enum InviteStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum RsvpStatus {
  ACCEPTED
  DECLINED
  MAYBE
}

class Host {
  + name : String [1]
  + email : String [1] {unique}
  + passwordHash : String [1]
}

class Invite {
  + eventName : String [1]
  + eventDate : Date [1]
  + eventTime : Time [1]
  + location : String [1]
  + status : InviteStatus [1]
  + publicToken : String [0..1] {unique}
  + capacityLimit : Integer [0..1]
  + maxCompanionsPerGuest : Integer [0..1]
  + /totalPeople : Integer [1]
}

class InviteCustomization {
}

class Template <<static asset>> {
  + code : String [1] {unique}
  + displayName : String [1]
  + openGraphImage : String [1]
}

class ColorSetting <<value>> {
  + role : String [1]
  + value : String [1]
}

class TextFieldLimit <<value>> {
  + field : String [1]
  + maxLength : Integer [1]
}

class Guest {
  + name : String [1]
  + status : RsvpStatus [1]
  + companionCount : Integer [1] = 0
  + personalToken : String [1] {unique}
  + respondedAt : DateTime [1]
}

class DietaryNote {
  + freeText : String [0..1]
}

class DietaryCategory <<reference data>> {
  + code : String [1] {unique}
  + displayName : String [1]
  + requiresDescription : Boolean [1]
}

Host "1\nhost" -- "0..*\ninvites" Invite

Invite "1\ninvite" *-- "0..1\ncustomization" InviteCustomization

InviteCustomization "0..*" --> "1\ntemplate" Template

Template "1" *-- "1..*\ndefaultColors" ColorSetting

InviteCustomization "1" *-- "0..*\ncolorOverrides" ColorSetting

Template "1" *-- "1..*\ntextFieldLimits" TextFieldLimit

Invite "1\ninvite" *-- "0..*\nguests" Guest
note on link
  Invariante do teto de pessoas (UC002 RN2, UC005 RN4, ADR-0008).
  Com capacityLimit preenchido, a soma de 1 mais companionCount
  de todo Guest com status ACCEPTED não pode ultrapassar capacityLimit.
end note

Guest "1\nguest" *-- "0..1\nnote" DietaryNote

DietaryNote "0..*\nnotes" -- "0..*\ncategories" DietaryCategory

@enduml

@startuml diagrama-casos-de-uso
' Fonte do Diagrama de Casos de Uso da Sprint 1.
' Gera o PNG com:
'   docker run --rm -v "<caminho>:/data" plantuml/plantuml -tpng /data/diagrama-casos-de-uso.puml
' Os nomes dos casos de uso seguem a Especificacao de Casos de Uso da wiki.

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor "Anfitrião" as Anfitriao
actor "Convidado" as Convidado

rectangle "App de Convites Virtuais" {
  usecase "UC001\nAutenticar anfitrião" as UC001
  usecase "UC002\nCriar convite" as UC002
  usecase "UC003\nPersonalizar visual\ndo convite" as UC003
  usecase "UC004\nCompartilhar convite\n(gerar link)" as UC004
  usecase "UC005\nConfirmar presença\n(RSVP)" as UC005
  usecase "UC006\nRegistrar observação\nalimentar" as UC006
  usecase "UC007\nVisualizar lista\nde presença" as UC007
  usecase "UC008\nConsolidar e exportar\nobservações alimentares" as UC008

  UC002 ..> UC003 : <<include>>
  UC006 ..> UC005 : <<extend>>
}

Anfitriao --> UC001
Anfitriao --> UC002
Anfitriao --> UC004
Anfitriao --> UC007
Anfitriao --> UC008

Convidado --> UC005

@enduml

@startuml diagrama-de-implantacao-slide
' Versão para o deck do Pitch: o mesmo conteúdo de docs/.attachments/diagrama-de-implantacao.puml,
' com fonte maior. Gera o PNG desta pasta com:
'   docker run --rm --user 0:0 -v "<caminho desta pasta>:/data" plantuml/plantuml -tpng /data/diagrama-de-implantacao-slide.puml
skinparam defaultFontSize 22
skinparam dpi 105
' Fonte do Diagrama de Implantação da Sprint 2, item #60 do Azure Boards.
' Gera o PNG sem instalar nada além do Docker, a partir da pasta onde este arquivo está:
'   docker run --rm -v "<caminho>:/data" plantuml/plantuml -tpng /data/diagrama-de-implantacao.puml
' No Windows, <caminho> é o caminho absoluto da pasta, por exemplo D:\invite-app\docs\.attachments
' Dois ambientes, pelo ADR-0015: o host de desenvolvimento, que era o único no ADR-0003, e o
' Railway, com os três serviços publicados para a demonstração e o navegador noutro dispositivo.
' Os três containers vêm do ADR-0002 e os artefatos da seção 10.3 do Guia da Arquitetura.
' O diagrama traz rótulo, não explicação. A leitura fica na página do Diagrama de Implantação.

skinparam shadowing false
skinparam monochrome true
skinparam defaultTextAlignment center
skinparam nodesep 20
skinparam ranksep 35
skinparam artifactFontSize 18

node "Máquina do integrante" <<device>> as HOST {

  node "Navegador" <<execution environment>> as BROWSER {
    artifact "front-client.bundle" as CLIENTRT
  }

  node "Docker Engine" <<execution environment>> as ENGINE {

    node "front" <<container>> as CFRONT {
      artifact "invite-app-front:<tag>" as IMGFRONT
      artifact "front-server.bundle" as SRVBUNDLE
      artifact "front-client.bundle" as CLIENTBUNDLE
      artifact "templates/" as TPL
      artifact "robots.txt" as ROBOTS
    }

    node "api" <<container>> as CAPI {
      artifact "invite-app-api:<tag>" as IMGAPI
      artifact "api.bundle" as APIBUNDLE
    }

    node "db" <<container>> as CDB {
      artifact "postgres:<tag>@<digest>" as IMGDB
      artifact "migrations/" as MIG
      database "invite_app" as DB
    }

    folder "invite-app_pgdata" <<volume>> as VOL
  }
}

node "Celular ou computador de quem abre o link" <<device>> as USERDEV {
  node "Navegador" <<execution environment>> as RBROWSER {
    artifact "front-client.bundle" as RCLIENTRT
  }
}

node "Railway" <<execution environment>> as RAILWAY {

  node "front" <<container>> as RFRONT {
    artifact "invite-app-front:<tag>" as RIMGFRONT
    artifact "front-server.bundle" as RSRVBUNDLE
    artifact "front-client.bundle" as RCLIENTBUNDLE
    artifact "templates/" as RTPL
    artifact "robots.txt" as RROBOTS
  }

  node "api" <<container>> as RAPI {
    artifact "invite-app-api:<tag>" as RIMGAPI
    artifact "api.bundle" as RAPIBUNDLE
    artifact "migrate.js" as RMIGRATE
    artifact "migrations/" as RMIG
  }

  node "Postgres" <<container>> as RDBNODE {
    database "PostgreSQL" as RDB
  }
}

artifact "docker-compose.yml" as COMPOSE
artifact ".env" as ENV
artifact "Variables" as RVARS

BROWSER -down- CFRONT : "HTTP  127.0.0.1:3000"
BROWSER -down- CAPI : "HTTP  127.0.0.1:3001"
CFRONT -down- CAPI : "HTTP  api:3000"
CAPI -down- CDB : "TCP  db:5432"
CDB -right- VOL : "/var/lib/postgresql/data"

CLIENTBUNDLE .up.> CLIENTRT : "<<deploy>>"

COMPOSE .down.> ENGINE
ENV .down.> ENGINE

HOST -[hidden]right- USERDEV

RBROWSER -down- RFRONT : "HTTPS  <front>.up.railway.app"
RBROWSER -down- RAPI : "HTTPS  <api>.up.railway.app"
RFRONT -down- RAPI : "HTTP  api.railway.internal:3000"
RAPI -down- RDBNODE : "TCP  postgres.railway.internal:5432"

RCLIENTBUNDLE .up.> RCLIENTRT : "<<deploy>>"

RVARS .down.> RAILWAY

@enduml
